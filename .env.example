# Copy this file to .env and fill in your real values (never commit .env — it's gitignored).
OPENAI_API_KEY=your-openai-api-key-here

# Login for /dashboard, /api/dashboard-data, /export/... and /participants/...
# (the browser asks for it). These pages stay locked until a password is set.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose-a-long-password
# More researcher logins for /dashboard and /admin (name:password, comma separated)
# DASHBOARD_USERS=ashley:password1,candace:password2

# Optional overrides:
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=low
# OPENSCORING_API_KEY=
# FLASK_DEBUG=1   # local development only
